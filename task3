import numpy as np

class MultilayerPerceptron:
    def __init__(self, w=None, b=0):
        self.w = w
        self.b = b

    def sigmoid(self, x):
        return 1 / (1 + np.exp(-x))

    def sigmoid_derivative(self, sigmoid_x):
        return sigmoid_x * (1 - sigmoid_x)

    def activate(self, x):
        return self.sigmoid(x)

    def Loss(self, y_pred, y_true):
        eps = 1e-8
        return -np.mean(y_true * np.log(y_pred + eps) + (1 - y_true) * np.log(1 - y_pred + eps))

    def forward_pass(self, X):
        self.z = np.dot(X, self.w) + self.b
        self.a = self.activate(self.z)
        return self.a

    def backward_pass(self, X, y, y_pred, learning_rate=0.01):
        n = X.shape[0]
        dz = (y_pred - y)*self.sigmoid_derivative(self.forward_pass(X))
        dw = (1 / n) * np.dot(X.T, dz)
        db = (1 / n) * np.sum(dz)

        self.w -= learning_rate * dw
        self.b -= learning_rate * db

    def fit(self, X, y, num_epochs=300, learning_rate=0.01):

        loss_values = []

        for i in range(num_epochs):
            y_pred = self.forward_pass(X)
            loss = self.Loss(y_pred, y)
            loss_values.append(loss)
            self.backward_pass(X, y, y_pred, learning_rate)

        return loss_values

    def predict(self, X):
        y_pred = self.forward_pass(X)
        return (y_pred >= 0.5).astype(int)

